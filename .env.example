# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Never commit.
# Used for: signed upload/download URLs, SHA-256 hashing of stored files,
# public counters, anonymous witness submissions, audit-log writes.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Public site URL (used for auth redirects). e.g. https://csjdm29.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Random string used to hash IP addresses for witness-form rate limiting. `openssl rand -hex 32`
IP_HASH_SALT=change-me
